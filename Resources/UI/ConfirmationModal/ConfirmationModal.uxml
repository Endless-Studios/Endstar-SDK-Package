<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="title-bar" style="flex-grow: 0; flex-shrink: 0; background-color: rgba(0, 0, 0, 0); border-bottom-width: 1px; border-bottom-color: rgba(0, 0, 0, 0.55);">
        <ui:Label tabindex="-1" text="Title Goes Here" display-tooltip-when-elided="true" name="title-label" style="font-size: 16px; -unity-font-style: bold; white-space: normal; padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;" />
    </ui:VisualElement>
    <ui:ScrollView name="body" horizontal-scroller-visibility="Hidden" style="flex-grow: 1; flex-shrink: 1; background-color: rgba(0, 0, 0, 0);">
        <ui:Label tabindex="-1" text="Body Goes Here" display-tooltip-when-elided="false" name="body-message-label" style="white-space: normal; padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;" />
    </ui:ScrollView>
    <ui:VisualElement name="footer" style="flex-grow: 0; flex-shrink: 0; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: flex-end; padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; border-top-width: 1px; border-top-color: rgba(0, 0, 0, 0.55);">
        <ui:Button text="Cancel" display-tooltip-when-elided="true" name="cancel-button" style="min-width: 90px; height: 22px; margin-right: 6px;" />
        <ui:Button text="Confirm" display-tooltip-when-elided="true" name="confirm-button" style="min-width: 90px; height: 22px; margin-right: 0;" />
    </ui:VisualElement>
</ui:UXML>
