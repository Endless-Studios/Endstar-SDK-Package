<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../Styles/EndstarSdkStyles.uss" />
    <ui:VisualElement name="window" class="browser-window">
        <ui:VisualElement name="header" class="browser-header-section">
            <ui:Label text="Asset Browser" name="title-label" class="browser-title-label" />
        </ui:VisualElement>
        <ui:VisualElement name="filter-bar" class="browser-filter-bar">
            <ui:VisualElement name="ownership-filter" class="browser-filter-group browser-filter-group--ownership">
                <ui:Button text="Mine" name="mine-button" class="browser-filter-button browser-filter-button--active" />
                <ui:Button text="Open Source" name="open-source-button" class="browser-filter-button" />
            </ui:VisualElement>
            <ui:VisualElement name="asset-type-filter" class="browser-filter-group browser-filter-group--asset-type" />
            <ui:VisualElement name="search-group" class="browser-filter-group browser-filter-group--search">
                <ui:TextField name="search-field" tooltip="Search" usage-hints="DynamicColor" keyboard-type="Search" auto-correction="true" class="browser-search-field" />
                <ui:Button text="×" name="clear-search-button" class="browser-clear-search-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="content-section" class="browser-content-section">
            <ui:ScrollView name="content-list" class="browser-content-list" />
            <ui:Label name="status-label" class="browser-status-label" style="display: none;" />
        </ui:VisualElement>
        <ui:VisualElement name="pagination-section" class="browser-pagination-section">
            <ui:Button text="◀" name="prev-page-button" class="browser-pagination-button" />
            <ui:Label name="page-info-label" text="1-20 of 100" class="browser-page-info-label" />
            <ui:Button text="▶" name="next-page-button" class="browser-pagination-button" />
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="browser-footer-section">
            <ui:Button text="Download" name="download-button" class="browser-footer-button primary-button" />
            <ui:Button text="Close" name="close-button" class="browser-footer-button secondary-button" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="asset-item-template" class="browser-asset-item" style="display: none;">
        <ui:VisualElement name="asset-icon-container" class="browser-asset-icon-container" />
        <ui:VisualElement name="asset-info-container" class="browser-asset-info-container">
            <ui:Label name="asset-name" text="Asset Name" class="browser-asset-name" />
            <ui:Label name="asset-type" text="Asset Type" class="browser-asset-type" />
            <ui:Label name="asset-description" text="Asset Description" class="browser-asset-description" />
        </ui:VisualElement>
        <ui:VisualElement name="asset-status-container" class="browser-asset-status-container">
            <ui:VisualElement name="local-indicator" class="browser-local-indicator" style="display: none;" />
            <ui:Label name="local-label" text="LOCAL" class="browser-local-label" style="display: none;" />
            <ui:VisualElement name="download-indicator" class="browser-download-indicator" style="display: none;" />
            <ui:Label name="download-label" text="NEW" class="browser-download-label" style="display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
